# Copia este fichero como .env.local para probar en tu ordenador.
# En Vercel, pon estas variables en Settings → Environment Variables.

# Base de datos Postgres (Vercel → Storage → Neon la crea y la rellena sola).
DATABASE_URL=postgres://usuario:contraseña@host/basedatos?sslmode=require

# Contraseña para entrar en /admin (larga y solo tuya).
ADMIN_PASSWORD=

# Secreto para firmar la sesión de /admin (cualquier texto largo y aleatorio).
SESSION_SECRET=

# Dirección pública de la web (para volver tras pagar con tarjeta).
SITE_URL=https://tu-dominio.com

# Pago con tarjeta (opcional). Sin estas dos, la tarjeta no se ofrece.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
