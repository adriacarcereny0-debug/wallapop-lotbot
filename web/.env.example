# Copia este fichero como .env.local para probar en tu ordenador.
# En Vercel, pon estas variables en Settings → Environment Variables.

# Base de datos Postgres. Supabase: Project Settings → Database → Connection
# string → «Transaction pooler» (puerto 6543). También vale Neon.
DATABASE_URL=postgres://usuario:contraseña@host:6543/postgres

# Clave SECRETA para firmar las licencias (Ed25519). Créala con:
#   node scripts/generar-claves.mjs
# La pública correspondiente va dentro de LOT Bot.
LICENSE_SIGNING_KEY=

# Contraseña para entrar en /admin (larga y solo tuya).
ADMIN_PASSWORD=

# Secreto para firmar la sesión de /admin (cualquier texto largo y aleatorio).
SESSION_SECRET=

# Dirección pública de la web (para volver tras pagar con tarjeta).
SITE_URL=https://tu-dominio.com

# Pago con tarjeta (opcional). Sin estas dos, la tarjeta no se ofrece.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Días de margen tras un cobro fallido antes de cortar la licencia (por defecto 5).
BILLING_GRACE_DAYS=5

# Horas que LOT Bot funciona sin conexión con un pase (por defecto 72).
LICENSE_LEASE_HOURS=72

# Actualizaciones (opcional). Ver web/README.md.
# Texto aleatorio de 32+ caracteres; el mismo va en GitHub → Secrets.
RELEASE_API_TOKEN=
# usuario/repositorio donde se publican las versiones.
GITHUB_RELEASES_REPO=
# Token de GitHub de solo lectura (Contents: Read) si el repositorio es privado.
GITHUB_RELEASES_TOKEN=
